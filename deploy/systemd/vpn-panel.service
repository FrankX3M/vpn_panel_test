[Unit]
Description=VPN Panel (FastAPI admin for VLESS+Reality / Hysteria2 / NaiveProxy)
After=network.target

[Service]
Type=simple
User=vpn-panel
Group=vpn-panel
WorkingDirectory=/opt/vpn_panel_test
Environment="PATH=/opt/vpn_panel_test/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/vpn_panel_test/.venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

# Панель слушает только localhost — наружу её отдаёт Caddy (reverse_proxy + basicauth),
# см. contracts/04_render_caddy.md и architecture.md, раздел 4.

[Install]
WantedBy=multi-user.target
