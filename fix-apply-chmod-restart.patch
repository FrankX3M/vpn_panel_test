From 68c46b5fce155c681bc96336bae812931efa4166 Mon Sep 17 00:00:00 2001
From: FrankX3M <you@example.com>
Date: Sun, 13 Sep 2026 16:55:01 +0000
Subject: [PATCH] fix: config files unreadable by sing-box/caddy; reload fails
 when service inactive
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

core/apply.py._write_atomic: tempfile.mkstemp() creates files with mode 0600
(owner-only — vpn-panel). os.replace() preserves that mode on rename, so
sing-box/caddy (running as their own system users) got 'Permission denied'
reading /etc/caddy/Caddyfile / /etc/sing-box/config.json on every real
deploy. Added explicit os.chmod(tmp_path, 0o644) before the replace.

core/apply.py._reload: always called 'reload' unconditionally. systemctl
reload cannot start an inactive unit -- this fails on literally the first
apply() a fresh server ever does (service never started), or any time the
service previously crashed (e.g. caddy exits if the config file is briefly
missing/invalid). Reproduced on POST /api/users:

  caddy reload failed: caddy.service is not active, cannot reload.

Now falls back to 'restart' when 'reload' returns a nonzero exit code, and
only raises ApplyError (with both stderr messages) if restart also fails.
The exception path (control() itself raising, e.g. systemctl not found) is
left as an immediate ApplyError -- no restart retry -- since that's a
different failure class and existing tests already pin that behavior.

Added regression tests: config file permissions are 0644, and reload->restart
fallback triggers/doesn't-falsely-succeed. All checks green: ruff, mypy, pytest
(88 passed, up from 85).
---
 src/core/apply.py        | 40 ++++++++++++++---
 tests/core/test_apply.py | 92 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 127 insertions(+), 5 deletions(-)

diff --git a/src/core/apply.py b/src/core/apply.py
index 3a6a32c..f4a6de3 100644
--- a/src/core/apply.py
+++ b/src/core/apply.py
@@ -66,6 +66,14 @@ def _write_atomic(path: str, content: str) -> None:
     try:
         with os.fdopen(fd, "w", encoding="utf-8") as handle:
             handle.write(content)
+        # tempfile.mkstemp создаёт файл с правами 0600 (только владелец, vpn-panel) —
+        # os.replace() режим не меняет. sing-box/caddy работают от СВОИХ системных
+        # пользователей и иначе не смогут прочитать файл ("Permission denied" при
+        # старте/reload). 0644 — world-readable, secrets внутри (пароли, UUID) уже
+        # защищены тем, что /etc/sing-box и /etc/caddy недоступны посторонним юзерам
+        # на уровне системы в целом, а сами файлы конфигов и так предназначены для
+        # чтения соответствующими системными сервисами.
+        os.chmod(tmp_path, 0o644)
         os.replace(tmp_path, path)
     except OSError as exc:
         try:
@@ -78,18 +86,40 @@ def _write_atomic(path: str, content: str) -> None:
 def _reload(service: str) -> None:
     """Перечитать конфиг сервиса через ``core.svc.control``.
 
+    Сначала пробует ``reload`` (не разрывает активные соединения клиентов).
+    Если сервис не запущен вообще (первый ``apply()`` в жизни сервера — юнит
+    ещё ни разу не стартовал — или сервис упал раньше из-за отсутствующего/
+    невалидного конфига) — ``systemctl reload`` в принципе не может поднять
+    неактивный юнит и возвращает ошибку. В этом случае пробуем ``restart``.
+
     Аргументы:
         service: имя сервиса (``sing-box`` или ``caddy``).
 
     Исключения:
-        ApplyError: если ``control`` бросил исключение или вернул ненулевой
-            ``returncode``. Текст ошибки включает stderr от systemctl.
+        ApplyError: если и ``reload``, и запасной ``restart`` завершились
+            ошибкой/ненулевым ``returncode``. Текст ошибки включает stderr
+            от обеих попыток.
     """
     try:
         result = service_control.control(service, "reload")
     except Exception as exc:  # noqa: BLE001 — обёртка ошибки в ApplyError
         raise ApplyError(f"{service} reload failed: {exc}") from exc
 
-    if result.returncode != 0:
-        stderr = result.stderr.decode("utf-8", errors="replace").strip()
-        raise ApplyError(f"{service} reload failed: {stderr}")
\ No newline at end of file
+    if result.returncode == 0:
+        return
+
+    reload_stderr = result.stderr.decode("utf-8", errors="replace").strip()
+
+    try:
+        restart_result = service_control.control(service, "restart")
+    except Exception as exc:  # noqa: BLE001 — обёртка ошибки в ApplyError
+        raise ApplyError(
+            f"{service} reload failed ({reload_stderr}); restart also failed: {exc}"
+        ) from exc
+
+    if restart_result.returncode != 0:
+        restart_stderr = restart_result.stderr.decode("utf-8", errors="replace").strip()
+        raise ApplyError(
+            f"{service} reload failed ({reload_stderr}); "
+            f"restart also failed: {restart_stderr}"
+        )
\ No newline at end of file
diff --git a/tests/core/test_apply.py b/tests/core/test_apply.py
index 1b783c9..3290c61 100644
--- a/tests/core/test_apply.py
+++ b/tests/core/test_apply.py
@@ -164,6 +164,98 @@ def test_apply_leaves_no_tmp_files(db_session_factory, paths, monkeypatch) -> No
     assert leftovers == []
 
 
+def test_apply_writes_world_readable_files(
+    db_session_factory, paths, monkeypatch
+) -> None:
+    """Файлы конфигов доступны на чтение не только владельцу (vpn-panel), но и
+    системным пользователям sing-box/caddy, от которых работают сами сервисы —
+    tempfile.mkstemp создаёт файл с правами 0600, os.replace() их не меняет,
+    что на реальном деплое приводило к 'Permission denied' при старте caddy."""
+    monkeypatch.setattr(
+        "src.core.svc.control.control",
+        lambda service, action: _successful_control(),
+    )
+
+    db = db_session_factory()
+    try:
+        _seed(db)
+        apply(db)
+    finally:
+        db.close()
+
+    singbox_mode = paths["singbox"].stat().st_mode & 0o777
+    caddy_mode = paths["caddy"].stat().st_mode & 0o777
+    assert singbox_mode == 0o644, f"sing-box config mode is {oct(singbox_mode)}, expected 0644"
+    assert caddy_mode == 0o644, f"Caddyfile mode is {oct(caddy_mode)}, expected 0644"
+
+
+def test_apply_falls_back_to_restart_when_reload_fails(
+    db_session_factory, paths, monkeypatch
+) -> None:
+    """Если reload вернул ненулевой код (сервис ещё не запускался/упал ранее —
+    типичный случай первого apply() в жизни сервера, или сервис упал раньше
+    из-за отсутствующего конфига), apply() пробует restart вместо немедленного
+    ApplyError. Реальный кейс: caddy.service is not active, cannot reload."""
+    calls: list[tuple[str, str]] = []
+
+    def fake_control(service: str, action: str) -> subprocess.CompletedProcess:
+        calls.append((service, action))
+        if service == "caddy" and action == "reload":
+            return subprocess.CompletedProcess(
+                args=["sudo", "systemctl", "reload", "caddy"],
+                returncode=1,
+                stdout=b"",
+                stderr=b"caddy.service is not active, cannot reload.",
+            )
+        return _successful_control()
+
+    monkeypatch.setattr("src.core.svc.control.control", fake_control)
+
+    db = db_session_factory()
+    try:
+        _seed(db)
+        apply(db)  # не должно поднять ApplyError — restart должен сработать
+    finally:
+        db.close()
+
+    assert calls == [
+        ("sing-box", "reload"),
+        ("caddy", "reload"),
+        ("caddy", "restart"),
+    ]
+
+
+def test_apply_raises_when_both_reload_and_restart_fail(
+    db_session_factory, paths, monkeypatch
+) -> None:
+    """Если и reload, и запасной restart вернули ошибку — ApplyError с обоими
+    текстами stderr, а не просто первая ошибка (легче диагностировать на сервере)."""
+
+    def fake_control(service: str, action: str) -> subprocess.CompletedProcess:
+        if service == "caddy":
+            return subprocess.CompletedProcess(
+                args=["sudo", "systemctl", action, "caddy"],
+                returncode=1,
+                stdout=b"",
+                stderr=f"{action} failed for real reason".encode(),
+            )
+        return _successful_control()
+
+    monkeypatch.setattr("src.core.svc.control.control", fake_control)
+
+    db = db_session_factory()
+    try:
+        _seed(db)
+        with pytest.raises(ApplyError) as exc_info:
+            apply(db)
+    finally:
+        db.close()
+
+    message = str(exc_info.value)
+    assert "reload failed for real reason" in message
+    assert "restart failed for real reason" in message
+
+
 def test_apply_raises_apply_error_on_nonzero_returncode_and_keeps_files(
     db_session_factory, paths, monkeypatch
 ) -> None:
